# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Neon PostgreSQL URL)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/housearmony?sslmode=require

# Server Port (Railway will set this automatically)
PORT=8080

# CORS Allowed Origins (comma-separated)
# For production, use your Vercel domain
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app
